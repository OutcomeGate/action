{
  "schemaVersion": "agentci.release.v2",
  "name": "starter-agent-v1",
  "runtime": {
    "kind": "node-jsonl",
    "protocolVersion": 1,
    "entry": "candidate.mjs"
  },
  "bundle": { "root": "release.bundle" },
  "model": {
    "kind": "none",
    "reason": "Deterministic credential-free starter candidate."
  },
  "components": {
    "prompts": ["prompt.md"],
    "toolSchemas": ["tool-schema.json"]
  },
  "candidate": {
    "credentials": { "kind": "none" }
  }
}
