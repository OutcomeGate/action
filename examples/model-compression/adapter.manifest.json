{
  "schemaVersion": "agentci.adapter-manifest.v1",
  "id": "support-routing.v1",
  "version": "1.0.0",
  "runtime": {
    "kind": "node-esm",
    "apiVersion": "agentci.adapter.v2",
    "protocolVersion": 1,
    "entry": "adapter.mjs",
    "operationTimeoutMs": 1000,
    "shutdownTimeoutMs": 250
  },
  "bundle": { "root": "adapter.bundle" },
  "contract": {
    "tools": ["ticket.auto_resolve", "ticket.escalate"]
  },
  "target": {
    "kind": "synthetic",
    "reason": "Self-contained support-routing comparison example",
    "configuration": {
      "namespace": "model-compression-routing-example"
    }
  },
  "credentials": { "environment": [] }
}
