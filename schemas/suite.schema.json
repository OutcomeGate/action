{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ci.invalid/schemas/suite.v1.json",
  "$comment": "Informative MVP sketch. src/suite.ts plus fixture-aware validation in src/fixtures/refunds.ts are authoritative.",
  "title": "OutcomeGate suite v1",
  "type": "object",
  "required": ["schemaVersion", "name", "version", "fixture", "gate", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "agentci.suite.v1" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "fixture": { "type": "string", "minLength": 1 },
    "gate": {
      "type": "object",
      "required": ["minPassRate"],
      "properties": {
        "minPassRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "toolError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fault": {
      "type": "object",
      "required": ["tool", "onCall", "phase", "error"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "onCall": { "type": "integer", "minimum": 1 },
        "phase": { "enum": ["before", "after"] },
        "error": { "$ref": "#/$defs/toolError" }
      },
      "additionalProperties": false
    },
    "jsonPointerAssertion": {
      "type": "object",
      "required": ["id", "type", "source", "pointer", "operator"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "type": { "const": "json_pointer" },
        "source": { "enum": ["state", "output"] },
        "pointer": { "type": "string", "pattern": "^/" },
        "operator": { "enum": ["equals", "absent"] },
        "expected": {}
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "const": "equals" } } },
          "then": { "required": ["expected"] }
        }
      ],
      "additionalProperties": false
    },
    "eventCountAssertion": {
      "type": "object",
      "required": ["id", "type", "tool", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "type": { "const": "event_count" },
        "tool": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["any", "ok", "error"] },
        "expected": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "eventOrderAssertion": {
      "type": "object",
      "required": ["id", "type", "tools"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "type": { "const": "event_order" },
        "tools": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "oneOf": [
        { "$ref": "#/$defs/jsonPointerAssertion" },
        { "$ref": "#/$defs/eventCountAssertion" },
        { "$ref": "#/$defs/eventOrderAssertion" }
      ]
    },
    "scenario": {
      "type": "object",
      "required": ["id", "description", "task", "initialState", "assertions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "task": {},
        "initialState": {},
        "faults": {
          "type": "array",
          "items": { "$ref": "#/$defs/fault" }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxToolCalls": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
