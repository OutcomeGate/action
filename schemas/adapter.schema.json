{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ci.invalid/schemas/adapter-manifest.v1.json",
  "$comment": "Informative contract sketch. src/adapter-manifest.ts is authoritative and adds normalization, HTTPS URL, process-control environment-name, filesystem, symlink, size, and stable-capture checks that JSON Schema cannot fully express.",
  "title": "Agent CI adapter manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "runtime",
    "bundle",
    "contract",
    "target",
    "credentials"
  ],
  "properties": {
    "schemaVersion": { "const": "agentci.adapter-manifest.v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "object",
      "required": [
        "kind",
        "apiVersion",
        "protocolVersion",
        "entry",
        "operationTimeoutMs",
        "shutdownTimeoutMs"
      ],
      "properties": {
        "kind": { "const": "node-esm" },
        "apiVersion": { "const": "agentci.adapter.v2" },
        "protocolVersion": { "const": 1 },
        "entry": { "$ref": "#/$defs/path" },
        "operationTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "shutdownTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/syntheticTarget" },
        { "$ref": "#/$defs/remoteTarget" }
      ]
    },
    "credentials": {
      "type": "object",
      "required": ["environment"],
      "properties": {
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true
    },
    "syntheticTarget": {
      "type": "object",
      "required": ["kind", "reason", "configuration"],
      "properties": {
        "kind": { "const": "synthetic" },
        "reason": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configuration" }
      },
      "additionalProperties": false
    },
    "remoteTarget": {
      "type": "object",
      "required": [
        "kind",
        "endpoint",
        "tenant",
        "apiVersion",
        "configuration"
      ],
      "properties": {
        "kind": { "const": "remote" },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "tenant": { "type": "string", "minLength": 1 },
        "apiVersion": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configuration" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
