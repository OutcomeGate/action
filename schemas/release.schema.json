{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ci.invalid/schemas/release.v1.json",
  "$comment": "Informative contract sketch. src/release.ts is authoritative and adds filesystem, symlink, size, and closed-bundle checks that JSON Schema cannot express.",
  "title": "Agent CI release manifest v1",
  "type": "object",
  "required": ["schemaVersion", "name", "runtime", "bundle", "model", "components"],
  "properties": {
    "schemaVersion": { "const": "agentci.release.v1" },
    "name": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "object",
      "required": ["kind", "protocolVersion", "entry"],
      "properties": {
        "kind": { "const": "node-jsonl" },
        "protocolVersion": { "const": 1 },
        "entry": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "required": ["root"],
      "properties": { "root": { "$ref": "#/$defs/path" } },
      "additionalProperties": false
    },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "none" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "provider", "identifier", "revision"],
          "properties": {
            "kind": { "const": "remote" },
            "provider": { "type": "string", "minLength": 1 },
            "identifier": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "configuration": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "components": {
      "type": "object",
      "required": ["prompts", "toolSchemas"],
      "properties": {
        "prompts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "toolSchemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    }
  },
  "additionalProperties": false
}
